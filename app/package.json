{
  "name": "philgeps-schema-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive explorer for PhilGEPS open-data schema evolution and OCDS mapping (2000–2025).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "regen-data": "python ../scripts/build_schema_field_map.py",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
